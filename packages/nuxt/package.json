{
  "name": "@happydesigns/course-nuxt",
  "version": "0.1.0",
  "description": "Comark reader layer for progressive technical courses.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./highlighting": "./highlighting.js",
    "./schemas": "./schemas/index.ts",
    "./storage": "./app/composables/useCourseStorage.ts",
    "./types": "./app/types/course.ts",
    "./preview": "./preview/nuxt.config.ts"
  },
  "files": [
    "app",
    "schemas",
    "highlighting.js",
    "highlighting.d.ts",
    "nuxt.config.ts",
    "preview"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @happydesigns/course build",
    "build": "nuxt prepare",
    "pretypecheck": "pnpm --filter @happydesigns/course build",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "pretest": "pnpm run build",
    "test": "vitest run --pool=threads --maxWorkers=1"
  },
  "dependencies": {
    "@comark/nuxt": "0.6.2",
    "@happydesigns/nuxt-variants": "^0.2.0",
    "@happydesigns/ui": "0.20.0",
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/ui": "^4.11.1",
    "comark": "0.6.2",
    "comark-content": "0.4.0",
    "shiki": "4.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@happydesigns/course": "workspace:^",
    "@nuxt/test-utils": "4.3.2",
    "@types/node": "^22.20.2",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.14.5",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "3.3.11"
  },
  "peerDependencies": {
    "@happydesigns/course": "^0.1.0",
    "nuxt": "^4.5.0"
  }
}

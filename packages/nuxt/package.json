{
  "name": "@happydesigns/course-nuxt",
  "version": "0.1.0",
  "description": "Nuxt Content reader layer for progressive technical courses.",
  "type": "module",
  "license": "MIT",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./schemas": "./schemas/index.ts",
    "./storage": "./app/composables/useCourseStorage.ts",
    "./types": "./app/types/course.ts"
  },
  "files": [
    "app",
    "schemas",
    "nuxt.config.ts"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @happydesigns/course build",
    "build": "nuxt prepare",
    "pretypecheck": "pnpm --filter @happydesigns/course build",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "pretest": "pnpm --filter @happydesigns/course build",
    "test": "vitest run --pool=threads --maxWorkers=1"
  },
  "dependencies": {
    "@happydesigns/course": "workspace:^",
    "@happydesigns/ui": "^0.20.0",
    "@happydesigns/nuxt-variants": "^0.2.0",
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/content": "^3.15.2",
    "@nuxt/ui": "^4.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "3.3.8"
  },
  "peerDependencies": {
    "nuxt": "^4.5.0"
  }
}

    "dev": "pnpm --filter @happydesigns/docs dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "tsx": "^4.19.4"
  }
}

{
  "name": "@happydesigns/course-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @happydesigns/course test",
    "build": "pnpm -r build",
    "validate:examples": "pnpm --filter @happydesigns/course course validate ../../examples/basic-course/course.json",
    "dev": "pnpm --filter @happydesigns/docs dev"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "tsx": "^4.22.4"
  }
}

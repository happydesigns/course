{
  "name": "@happydesigns/course-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @happydesigns/course test",
    "build": "pnpm -r build",

    "@nuxt/content": "^3.16.0",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/mdc": "0.23.1",
    "comark": "0.7.0",
    "nuxt": "^4.5.2",
    "shiki": "4.3.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "vue-tsc": "3.3.11"

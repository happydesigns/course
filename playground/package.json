  },
  "dependencies": {
    "@comark/vue": "0.7.0",
    "@happydesigns/course-nuxt": "workspace:*",
    "@iconify-json/lucide": "^1.2.131",
    "@iconify-json/material-icon-theme": "^1.2.70",
    "@iconify-json/simple-icons": "^1.2.95",

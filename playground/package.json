  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "pretest": "node ../scripts/with-nuxt-lock.mjs pnpm exec nuxt prepare",
    "test": "vitest run --maxWorkers=1",
